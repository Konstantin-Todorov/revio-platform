{
  "name": "@revio/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "cert-property": "tsx scripts/cert-property.ts",
    "rls-verify": "tsx scripts/rls-verify.ts",
    "claim-verify": "tsx scripts/claim-verify.ts",
    "lease-verify": "tsx scripts/lease-verify.ts",
    "state-audit": "psql \"$DATABASE_URL\" -f scripts/state-audit.sql",
    "rotate-connectivity-key": "tsx scripts/rotate-connectivity-key.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@revio/core": "workspace:*",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
