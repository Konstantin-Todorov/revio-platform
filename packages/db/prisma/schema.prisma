// Revio persistence schema. Every tenant-owned row carries tenantId (RLS added via raw-SQL migration).
// Domain math lives in @revio/core; this schema only stores and retrieves.

generator client {
  provider = "prisma-client-js"
}

// Two connections, because migrating and running want opposite privileges.
//   url       — the RUNTIME connection. In production this is the restricted `revio_app` role, which
//               is the only way RLS actually bites: Postgres ignores policies for superusers, and
//               FORCE only reaches the table owner.
//   directUrl — the OWNER connection, used by `prisma migrate` for DDL. The app role deliberately
//               cannot create or alter tables, so without this every deploy would fail at
//               `migrate deploy` before it ever started the server.
//
// `directUrl` is REQUIRED once declared — Prisma does not fall back to `url` when the env var is
// missing. Since `migrate deploy` runs on every Railway deploy, adding this line before
// DIRECT_DATABASE_URL exists on a service breaks that service's next deploy. It is set on all five.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// --- Tenancy ---------------------------------------------------------------

model Tenant {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  // Entitlements: which products this hotel account bought ("sold separately").
  hasChannelManager  Boolean   @default(true)
  hasReservation     Boolean   @default(false)
  hasPms             Boolean   @default(false)
  // Commercial profile, set by the operator. plan ≈ room-count tier / package; status gates access.
  plan               String    @default("starter") // starter | growth | scale
  status             String    @default("active") // active | suspended
  // Ours, for testing — kept alongside real clients in production forever, because a staging copy of
  // a five-app platform is a second thing to keep in sync and it always drifts. A demo tenant behaves
  // EXACTLY like a real one in every product; the flag only stops the operator console counting it as
  // business. See apps/operator/lib/demo.ts for the rule.
  isDemo             Boolean   @default(false)
  /// When this client became billable — the moment their first booking actually synced.
  ///
  /// The public promise is "free until your first booking syncs", and until this column existed the
  /// software did not implement it: invoices generated from the month a tenant was created, whether
  /// or not the platform had ever done anything for them. A promise on a pricing page that the
  /// billing code ignores is the kind of thing a customer discovers on their first invoice.
  ///
  /// Null = not yet billable. A property that never takes a booking stays free forever, which is the
  /// correct answer: no value delivered, no charge.
  ///
  /// Set once, by the first successful channel pull that imports a reservation, and never moved —
  /// re-stamping it on a later sync would restart the free period and quietly cancel the bill.
  billingStartsAt    DateTime?
  /// An EXPLICIT, reasoned exception to the tier the room count implies.
  ///
  /// `plan` above used to be a free dropdown, while a panel elsewhere measured the disagreement
  /// between it and the room count — the console manufacturing the drift it then reported. The tier
  /// is now derived; this is the escape hatch, and it is deliberately expensive to use: no reason,
  /// no override.
  planOverride       String?
  planOverrideReason String?
  planOverrideById   String?
  planOverrideAt     DateTime?
  createdAt          DateTime  @default(now())

  properties Property[]
  users      User[]

  // Operator-only CRM. Named `crm*` so no call site can mistake our private record of a client for
  // the client's own data — RLS blocks it from a hotel connection either way.
  crmAccount  ClientAccount?
  crmContacts ClientContact[]
  crmNotes    ClientNote[]
  crmBilling  ClientBilling?
}

model User {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  email             String    @unique
  // Shared account role for the whole platform (CM/CRS taxonomy) PLUS the PMS operational roles
  // (manager | reception | housekeeper | hk_supervisor | maintenance | outlet_pos). One identity,
  // one role — the PMS User Management (§3.9) is a scoped view onto this shared identity.
  role              String // owner | admin | revenue_manager | distribution_manager | read_only | manager | reception | housekeeper | hk_supervisor | maintenance | outlet_pos
  passwordHash      String? // null until the invited Owner sets their password
  phone             String? // shared contact number; editable from any product's user-management surface
  active            Boolean   @default(true) // deactivated staff keep their identity but can't sign in
  // Sessions issued before this instant are dead (see checkSessionValidity in @revio/core). Set by a
  // password change and by "sign out everywhere" — never routinely, because moving it signs the
  // person out of the device in their hand too. Null = never revoked.
  sessionsValidFrom DateTime?
  /// Two-factor authentication, on the SHARED identity — enrolling once in RevioCRS protects the
  /// same person in RevioLink and RevioPMS. Three per-app secrets would be three chances to leave
  /// one unprotected, and the account is one person either way.
  /// `totpSecret` is encrypted at rest. `totpLastStep` makes each 30-second step single-use, which
  /// is what people already assume a one-time password means.
  totpSecret        String?
  totpEnabledAt     DateTime?
  totpLastStep      Int?

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recoveryCodes UserRecoveryCode[]

  @@index([tenantId])
}

// Operator staff (us). Cross-tenant by design — NOT tied to any tenant.
model OperatorUser {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  role              String    @default("super_admin") // super_admin | support
  /// Null until the invitation is accepted — an operator account that nobody has claimed cannot sign in.
  passwordHash      String?
  /// Deactivated operator staff keep their identity (they own ClientAccount rows) but cannot sign in.
  /// This column did not exist until 2026-08-12: the console that can read every hotel's data had no
  /// way to revoke a leaver short of deleting the row, which the ownedAccounts relation forbids.
  active            Boolean   @default(true)
  /// Sessions issued before this instant are dead — see User.sessionsValidFrom.
  sessionsValidFrom DateTime?

  // --- Two-factor authentication (N4) -------------------------------------------------------
  /// The TOTP shared secret, ENCRYPTED at rest with the same AES-256-GCM helper the OTA
  /// credentials use. A plaintext secret in this column is a second factor that the database
  /// hands to anyone who can read it, which is no second factor at all.
  totpSecret    String?
  /// Null until a code has actually been verified. Enrolment stores the secret first and only
  /// switches 2FA ON once the person proves their app generates matching codes — otherwise a
  /// mistyped setup locks them out of the console with no way back in.
  totpEnabledAt DateTime?
  /// The last 30-second step accepted for this account, so a code cannot be replayed inside its
  /// own window. TOTP is only single-use if something remembers; without this a code read over a
  /// shoulder stays valid for the rest of its period.
  totpLastStep  Int?

  createdAt DateTime @default(now())

  ownedAccounts ClientAccount[]
  recoveryCodes OperatorRecoveryCode[]
}

/// A single-use way back in when the phone with the authenticator app is gone.
///
/// Hashed, never stored in the clear: a leaked recovery code is a bypass of the second factor, so
/// it deserves exactly the treatment a password gets. Used codes are kept rather than deleted —
/// "this code was used, at this time" is the audit answer to "how did they get in without the app".
model OperatorRecoveryCode {
  id             String    @id @default(cuid())
  operatorUserId String
  codeHash       String
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  operatorUser OperatorUser @relation(fields: [operatorUserId], references: [id], onDelete: Cascade)

  @@index([operatorUserId])
}

// Per-tenant connectivity credential (e.g. a Channex API key), AES-256-GCM encrypted at rest.
// Operator-managed; a hotel can NEVER read it (RLS policy = bypass-only). The CM reads it server-side
// at push/pull time via the system perimeter — the plaintext key is never sent to any client.
model ConnectivityCredential {
  id               String    @id @default(cuid())
  tenantId         String
  mode             String // channex_sandbox | channex_prod
  cipher           String // base64 iv.tag.ciphertext (AES-256-GCM)
  /// When this key was last exercised against Channex, and what happened.
  ///
  /// Stored rather than checked on render: the connectivity screen would otherwise make one live
  /// HTTP call per client per page load, and a slow Channex would make our own console look broken.
  /// A key is tested when it is saved and whenever somebody presses Check now.
  ///
  /// `lastCheckOk = null` means never tested — which is NOT the same as working, and the screen
  /// must not colour it green.
  lastCheckedAt    DateTime?
  lastCheckOk      Boolean?
  lastCheckMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, mode])
  @@index([tenantId])
}

// A demand-generation enquiry from the public website — operator-only, like everything else that is
// ours ABOUT a prospect rather than a hotel's own data.
//
// It exists because a demo request used to be an email and nothing else. Resend delivered every one
// of them, and the founder still could not find them: a mail client is a notification channel, not a
// record, and a lead that is filtered, archived by accident or read on a phone and forgotten leaves
// no trace anywhere in the product. This is the place to look.
//
// Deliberately NOT a Tenant or a ClientAccount. These people are not customers and most never will
// be; giving them a tenant row would put strangers into every portfolio count on the Overview.
model Lead {
  id            String    @id @default(cuid())
  name          String
  email         String
  company       String?
  /// Free text as typed — "40", "about 25", "12 apartments". Never parsed into a number: the answer
  /// to "how many rooms" is sometimes a sentence, and coercing it loses what they actually said.
  rooms         String?
  currentSystem String?
  channels      String?
  /// Products they ticked, comma-separated as the form sent them.
  interestedIn  String?
  message       String?
  /// The figure the pricing calculator was showing when they asked — so a reply quotes the same
  /// number they were looking at rather than recomputing it into a different one.
  quote         String?
  page          String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  referrer      String?
  /// Set when somebody has dealt with it. Null is the working queue.
  handledAt     DateTime?
  handledById   String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([handledAt])
}

// One-time recovery codes for a HOTEL staff account (mirrors OperatorRecoveryCode). Hashed with
// bcrypt like a password — a leaked table must not be a set of working credentials. `usedAt` rather
// than deletion, so "already used" can be said out loud: that is a different problem for the person
// holding the printed sheet than "wrong code".
model UserRecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Operator-side billing (our invoices to the hotels). Operator business data — a hotel can NEVER read
// it (RLS = bypass-only, like ConnectivityCredential). Payments are MOCKED in V1 (no gateway): status
// moves draft → sent → paid manually; no card/money is handled here.
model Invoice {
  id          String    @id @default(cuid())
  tenantId    String
  period      String // billing month "YYYY-MM"
  /// The NET price for the period — list prices exclude VAT. See apps/operator/lib/vat.ts.
  amountMinor Int
  currency    String    @default("EUR")
  status      String    @default("draft") // draft | sent | paid
  lineItems   String? // human-readable summary of what's billed (plan + products)
  createdAt   DateTime  @default(now())
  paidAt      DateTime?

  // --- The issued document -------------------------------------------------
  // Everything below is NULL while the invoice is a draft and frozen the moment it is issued.
  // `number == null` is therefore the same statement as "not yet issued", which is why issuing is a
  // transition rather than a field somebody can edit.
  //
  // These are SNAPSHOTS, not lookups. Our address, our bank account and the customer's VAT number
  // all change over time, and a document that silently reprints with today's details is no longer
  // the document that was sent. An invoice has to keep saying what it said.
  /// Gapless, allocated at issue: "REV-2026-0001".
  number          String?   @unique
  issuedAt        DateTime?
  dueDate         DateTime?
  issuerName      String?
  issuerVatId     String?
  issuerCompanyId String?
  issuerAddress   String?
  issuerIban      String?
  issuerBic       String?
  issuerBankName  String?
  buyerName       String?
  buyerVatId      String?
  buyerCompanyId  String?
  buyerAddress    String?
  netMinor        Int?
  taxMinor        Int?
  grossMinor      Int?
  vatRatePct      Int?
  /// domestic | eu_reverse_charge | eu_b2c | outside_eu | not_registered
  vatTreatment    String?
  /// Printed beside a 0% line. A zero with no reason is not a valid invoice.
  vatNote         String?
  /// The billed lines as they read at issue, so a later price change cannot rewrite history.
  lineSnapshot    Json?

  /// WHO settled it, WHEN, and against WHAT. Manual payment recording is fine; unattributable
  /// manual payment recording is not — "paid" with nobody's name on it is not a ledger entry.
  paidById      String?
  paidReference String?

  @@unique([tenantId, period])
  @@index([tenantId])
}

/// An unhandled server error, aggregated by signature.
///
/// Deliberately one row per DISTINCT fault, not one per occurrence. A single bug on a hot route
/// produces thousands of identical exceptions; storing each is how an error log fills a database and
/// buries the second, rarer bug that actually needed reading. `count` carries the volume, which is
/// the only part that differs.
///
/// `operator_only` — a stack trace can contain a query, an id, a fragment of somebody's data, and it
/// is ours to read, never a hotel's.
model AppError {
  id          String    @id @default(cuid())
  /// Which app: cm | crs | pms | operator | booking.
  service     String
  /// Stable hash of the message plus the first application stack frame. Two occurrences of the same
  /// fault must collide here, or aggregation does nothing.
  signature   String
  message     String
  /// The route being served, when known — usually the fastest route to reproducing it.
  route       String?
  stack       String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  /// Set when somebody has dealt with it. A resolved fault that recurs is un-resolved automatically.
  resolvedAt  DateTime?
  /// When we last emailed about this signature — the rate limit that stops an alert storm.
  notifiedAt  DateTime?

  @@unique([service, signature])
  @@index([resolvedAt, lastSeenAt])
}

/// Our own legal identity, as it appears on every invoice we send.
///
/// A single row — there is one Revio. Modelled as a table rather than environment variables because
/// an address or a bank account is something an operator should be able to correct at 9pm without a
/// deploy, and because the values have to be snapshotted onto each invoice anyway.
model OperatorCompany {
  id                 String   @id @default("singleton")
  /// The registered name in Cyrillic, as it appears in the Bulgarian commercial register.
  legalName          String
  /// The same entity in Latin script, for customers who cannot read the Cyrillic one.
  ///
  /// Both are legitimate names for the same company — this is not a translation, it is the other
  /// official rendering. An invoice picks by the customer's country so a German hotel does not
  /// receive a document it cannot file, and a Bulgarian one gets the name its accountant expects.
  /// Empty means "we only have the one", and the Cyrillic name is used for everybody.
  legalNameLatin     String?
  /// Registered address in Latin, paired with `legalNameLatin`. Kept together deliberately: an
  /// invoice carrying a Cyrillic name above a Latin address reads as two different companies.
  addressLineLatin   String?
  cityLatin          String?
  /// Absent = not VAT registered, which zero-rates every invoice. See decideVat().
  vatId              String?
  /// Company registration number (EIK in Bulgaria).
  companyId          String?
  addressLine        String?
  city               String?
  postCode           String?
  /// ISO 3166-1 alpha-2. Decides domestic vs reverse charge for every customer.
  country            String   @default("BG")
  email              String?
  phone              String?
  website            String?
  iban               String?
  bic                String?
  bankName           String?
  /// Our domestic standard VAT rate, percent.
  standardVatPct     Int      @default(20)
  /// Where this software's range of invoice numbers begins.
  ///
  /// Bulgarian law (ЗДДС чл. 114(1)(2), ППЗДДС чл. 78) requires a TEN-DIGIT number containing only
  /// Arabic numerals, ascending, with no duplication and no gaps — and it explicitly permits several
  /// ranges for one taxable person. So the software takes its own range well clear of the numbers
  /// already issued by hand: 1000000000 upward, leaving 0000000001–0999999999 to the existing books.
  ///
  /// BigInt because a ten-digit number reaches 9999999999, which overflows a 32-bit integer. Only
  /// read when the counter is first created — moving it afterwards would either repeat a number or
  /// leave a gap, and both are exactly what the rule forbids.
  invoiceNumberStart BigInt   @default(1000000000)
  paymentTermsDays   Int      @default(14)
  /// Free text printed at the foot of every invoice.
  footerNote         String?
  updatedAt          DateTime @updatedAt
}

/// The invoice counter. One row per independent run of numbers.
///
/// **Not keyed by year.** An annual reset is normal across much of Europe and is wrong here:
/// Bulgarian numbering is one continuous ascending run for the life of the company, so a year in the
/// key would produce a duplicate every January.
///
/// `kind` is "real" or "demo". Demo tenants are billed like real ones so the flow stays testable, and
/// their numbers must never come out of the legally-sequenced range.
model OperatorInvoiceSeries {
  id         String @id @default(cuid())
  kind       String @unique
  /// BigInt: a ten-digit number reaches 9999999999 and a 32-bit integer stops at 2147483647.
  nextNumber BigInt
}

/// A client's LEGAL identity, for the invoice we send them.
///
/// Deliberately not part of ClientAccount. That table holds what we BELIEVE about a relationship —
/// its stage, a summary, who owns it — and this holds facts that get printed on a tax document. Kept
/// apart so a CRM note and a legally-binding company name are not edited by the same hand on the
/// same screen, and so its absence means something precise: this client cannot be invoiced yet.
///
/// `Tenant.name` is the trading name the hotel uses ("Hotel Sofia Group"); `legalName` is the entity
/// that actually owes the money, and they are routinely different.
model ClientBilling {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  legalName    String
  vatId        String?
  companyId    String?
  addressLine  String?
  city         String?
  postCode     String?
  /// ISO 3166-1 alpha-2. Absent blocks issuing — see decideVat(), which refuses to guess.
  country      String?
  billingEmail String?
  /// Who the invoice should be addressed to — "Accounts payable", a finance manager's name.
  attention    String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// --- Operator CRM (L6) ------------------------------------------------------
// Everything in this block is OURS, *about* a client, and the hotel must never read a word of it.
// Same `operator_only` RLS as Invoice / ConnectivityCredential / OperatorUser: rows exist only under
// `app.bypass = 'on'`. "Called the owner, he is unhappy about the March invoice" is exactly the kind
// of note that must be impossible to leak through an application bug, so it is locked at the database
// rather than by remembering to filter it.
//
// The back-relations on Tenant are named `crm*` so a call site cannot mistake this perimeter for the
// hotel's own data — `tenant.notes` would read like guest notes; `tenant.crmNotes` cannot.

// The commercial relationship with one client: who owns it, where it is in its life, when it renews.
// One row per tenant, created lazily the first time an operator writes anything to it.
model ClientAccount {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  /// STATED stage — what we believe. Deliberately not derived: the console derives an *observed*
  /// stage from behaviour and shows the two side by side, because the disagreement ("you have them
  /// down as live; they have not taken a booking in six weeks") is the useful signal. A single
  /// auto-computed field would silently overwrite the human judgement instead of arguing with it.
  stage              String    @default("onboarding") // prospect | onboarding | live | at_risk | churned
  /// Which of our staff owns this relationship. SetNull, so removing an operator never orphans a client.
  ownerOperatorId    String?
  /// Contract renewal / anniversary. Date-only: a renewal is a calendar day, not an instant.
  renewalDate        DateTime? @db.Date
  contractTermMonths Int?
  /// The one line you want in front of you before dialling.
  summary            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerOperator OperatorUser? @relation(fields: [ownerOperatorId], references: [id], onDelete: SetNull)
}

// A person we talk to. NOT a `User` — the person who signs the contract and the person who logs in
// are routinely different people, and the owner who decides on renewal often has no login at all.
// Modelling them as staff accounts would mean inventing logins for people who must never have one.
model ClientContact {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// Their job, in their words: "Owner", "General Manager", "Revenue", "Accounts payable".
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  /// Where invoices should go. Separate from primary: the person who pays is rarely the one who buys.
  isBilling Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// One entry in the relationship log. `occurredAt` is separate from `createdAt` because a call is
// logged after it happens — sorting a timeline by row-creation time puts last week's call at the top.
model ClientNote {
  id         String   @id @default(cuid())
  tenantId   String
  kind       String   @default("note") // note | call | email | meeting | issue
  body       String
  authorId   String?
  /// Snapshot of who wrote it, so the log still reads correctly after that operator leaves.
  authorName String
  pinned     Boolean  @default(false)
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
}

// --- Property & sellable products -----------------------------------------

model Property {
  id                        String    @id @default(cuid())
  tenantId                  String
  name                      String
  timezone                  String    @default("Europe/Sofia")
  baseCurrency              String    @default("EUR")
  defaultLanguage           String    @default("en")
  syncHorizonDays           Int       @default(365)
  address                   String?
  contactEmail              String?
  phone                     String?
  checkInTime               String    @default("14:00")
  checkOutTime              String    @default("12:00")
  status                    String    @default("active")
  // PMS Phase 5: the current open operational date (night audit rolls it forward). Null until first close.
  businessDate              DateTime? @db.Date
  // Who closed the last business day. An auto-close is a real financial close, but it is a close no
  // human reviewed — and a run of them says nobody is minding the desk. That is only legible if the
  // actor is recorded rather than inferred from silence.
  lastCloseWasAutomatic     Boolean   @default(false)
  lastClosedAt              DateTime?
  // Which products this property has finished first-run setup for ("cm" | "crs" | "pms"). Written
  // once, the first time a product's checklist comes out complete, so the welcome card never
  // reappears later — e.g. when adding a room type temporarily leaves a mapping unmapped.
  setupCompleted            String[]  @default([])
  // Reservation delivery (CM-UPDATES-V1 Settings): where channel bookings are emailed when the
  // property is NOT connected to a PMS/CRS — plus the arrival-summary notification toggles.
  reservationEmailPrimary   String?
  reservationEmailSecondary String?
  notifyTodayArrivals       Boolean   @default(false)
  notifyTodayTime           String    @default("07:00") // property-TZ send time
  notifyTodayTo             String    @default("primary") // primary | secondary | both
  notifyTomorrowArrivals    Boolean   @default(false)
  notifyTomorrowTime        String    @default("18:00")
  notifyTomorrowTo          String    @default("primary")
  // Guest-facing email branding (email engine): each hotel's mail looks like THEIRS, not like Revio's.
  // The sending domain stays ours (deliverability), but the name, reply-to, logo and accent are the
  // hotel's. Null = fall back to the property name / platform default.
  emailSenderName           String?
  emailReplyTo              String?
  emailLogoUrl              String? // absolute URL, if the hotel pastes one instead of uploading
  // An uploaded logo is served from our own domain by /api/brand/[propertyId]/logo. Email clients
  // block data: URIs and won't authenticate, so the logo must be a plain public HTTPS URL — which
  // means we host it. Bumped on every upload so the cached copy in a client is replaced.
  emailLogoVersion          Int       @default(0)
  emailBrandColor           String? // hex, e.g. "#0E7C86" — headings + button colour
  emailFooterText           String? // address / legal line under the signature
  // Visual identity of the mail itself — so two hotels on Revio never send identical-looking email.
  emailTheme                String    @default("classic") // classic | modern | minimal | boutique
  emailFont                 String    @default("serif") // serif | sans | mixed
  // Booking engine (RevioDirect). `publicSlug` is the hotel's PUBLIC address —
  // book.revio.app/<slug> — so it ends up in printed QR codes and Instagram bios and is treated as
  // permanent once issued. Nullable because a property has no public presence until the engine is
  // switched on, and unique because it resolves a single property with no tenant context.
  publicSlug                String?   @unique
  bookingEngineEnabled      Boolean   @default(false)
  // The engine's OWN presentation, deliberately not shared with the email* fields above. A hotel can
  // reasonably want a quiet, traditional confirmation email and a bold booking page; one shared
  // column would force each to follow the other. NULL means "inherit from the email branding", so a
  // hotel that configures nothing still gets a coherent page from day one and only the fields they
  // actually touched diverge.
  bookingPreset             String    @default("clean") // clean | warm | bold — see BOOKING_PRESETS
  bookingBrandColor         String? // hex; null = inherit emailBrandColor
  bookingFont               String? // serif | sans; null = inherit emailFont
  bookingLogoUrl            String? // absolute URL; null = inherit the email logo
  bookingHeadline           String? // hero headline; null = platform default
  bookingSubheadline        String?
  bookingShowTrust          Boolean   @default(true) // the "why book direct" row
  // The hero background photograph (BG1). KEYS only — the bytes are in object storage via
  // @revio/storage, same rule as RoomTypePhoto and for the same arithmetic. Null throughout means
  // no photo, which is a designed state rather than a missing one: the preset's own hero still runs.
  bookingHeroKey            String? // object key, the 2400px page image
  bookingHeroThumbKey       String? // object key, the small one the CRS editor previews
  bookingHeroWidth          Int?
  bookingHeroHeight         Int?
  // How bright the photo's brighter regions actually are, 0–1000 (see HERO_LUMINANCE_SCALE).
  // MEASURED at upload, because the darkening layer that keeps the headline readable is derived
  // from it rather than guessed — a night shot needs none and a white facade needs half.
  bookingHeroLuminance      Int?
  bookingHeroFocalY         Int       @default(50) // 0–100; which band survives the crop
  bookingHeroOverlay        String    @default("balanced") // minimal | balanced | strong — never below the measured floor
  // Stripe Connect (spec §2.5③). The hotel's OWN Stripe account — the guest's card is authorised
  // against it and funds go straight to them, so we never hold client money and never need a
  // payment-institution licence. `chargesEnabled` mirrors Stripe's own flag rather than being our
  // opinion: onboarding can be "submitted" and still not accept charges, and only Stripe knows.
  // Until it is true the booking engine runs in REQUEST-TO-BOOK mode, so a hotel is never blocked
  // from selling while its paperwork clears.
  stripeAccountId           String?   @unique
  stripeChargesEnabled      Boolean   @default(false)
  stripeCheckedAt           DateTime? // last time we asked Stripe, so the screen can say how fresh it is
  // CRS Distribution (spec §3.8): exactly ONE connected channel manager per property.
  // reviolink_internal = the platform's own CM (shared core, automatic mapping); third-party
  // kinds plug into the identical ChannelManagerConnector interface later — never a second path.
  cmKind                    String    @default("reviolink_internal")
  // Connection lifecycle at the CM level: pausing stops distribution reversibly; disconnecting
  // preserves the CRS↔CM mapping dormant so resuming never forces a re-map.
  cmStatus                  String    @default("connected") // connected | paused | disconnected

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roomTypes            RoomType[]
  ratePlans            RatePlan[]
  channels             Channel[]
  cancellationPolicies CancellationPolicy[]
  mealPlans            MealPlan[]
  ratePrices           RatePrice[]
  dailyCells           DailyCell[]
  restrictionRules     RestrictionRule[]
  reservations         Reservation[]
  syncEvents           SyncEvent[]
  errorItems           ErrorItem[]
  auditEntries         AuditEntry[]
  inventoryPeriods     RoomInventoryPeriod[]
  holds                Hold[]
  guests               Guest[]
  bookingSources       BookingSource[]
  taxesFees            TaxFee[]
  pickupSnapshots      PickupSnapshot[]
  defaults             PropertyDefaults?
  units                Unit[]
  hkTasks              HousekeepingTask[]
  roomAssignments      RoomAssignment[]
  folios               Folio[]
  folioLines           FolioLine[]
  posItems             PosItem[]
  depositTypes         DepositType[]
  invoiceSeries        InvoiceSeries[]
  taxInvoices          TaxInvoice[]
  maintenanceTasks     MaintenanceTask[]
  staffShifts          StaffShift[]
  opsEvents            OpsEvent[]
  emailTemplates       EmailTemplate[]
  brandAssets          BrandAsset[]
  stayGuests           StayGuest[]

  @@index([tenantId])
}

// One editable email per property per type (email engine). A row exists only once a hotel customises
// that email — until then the platform default (packages/core/email-templates) is used, so a new
// property sends sensible mail on day one with nothing configured.
//
// `enabled` is the hotel's on/off switch for that email type; `subject`/`body` are their wording, with
// {{placeholders}} substituted at send time. Body is plain text with simple markers — deliberately not
// a rich HTML editor, so a hotel cannot break rendering or accessibility.
model EmailTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  key        String // booking_confirmation | booking_modified | … (see core catalog)
  // Guest-facing mail is written per language: one row per property+key+locale. The guest's own
  // language wins, then the property default, then English.
  locale     String   @default("en")
  enabled    Boolean  @default(true)
  subject    String
  body       String
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key, locale])
  @@index([propertyId])
}

model RoomType {
  id               String   @id @default(cuid())
  tenantId         String
  propertyId       String
  name             String
  code             String
  // room | bed | apartment. Hotels/apartments sell whole units; hostels sell beds, so a "bed"
  // unitKind means totalRooms counts beds and availability is controlled per bed.
  unitKind         String   @default("room")
  // Physical room/bed count — a CAP & safety-net only. Rooms-to-sell is managed per date
  // (DailyCell.inventory); exceeding totalRooms warns but does not block.
  totalRooms       Int
  /// The occupancy ceiling — how many occupancy rows a per-person plan carries, and what "doesn't
  /// fit" is measured against. This is `max_occupancy` in the OBP spec; the name predates it.
  maxGuests        Int
  /// Which occupancy is the PRIMARY one — the rate shown by default and the one restrictions ride
  /// on. Null means "the ceiling", which is the pre-OBP behaviour and the correct default: a room
  /// priced per-room is priced for a full room.
  defaultOccupancy Int?
  description      String?
  // Guest-facing room content (K11). All optional: a hotel goes live before its copywriting, and
  // every surface renders correctly with any subset of these, including none of them.
  sizeSqm          Int? // floor area, the single most-asked question about a room
  bedSetup         String? // key from BED_SETUPS in @revio/core — a fixed list so rooms compare
  // Keys from ROOM_AMENITIES. A fixed vocabulary, because this is what Channex takes as a room
  // type's `facilities` list — fill it in once here and the OTAs get it later without re-entry.
  amenities        String[] @default([])
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)

  property         Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlanLinks    RatePlanRoomType[]
  channelMappings  ChannelRoomTypeMapping[]
  ratePrices       RatePrice[]
  dailyCells       DailyCell[]
  resLines         ReservationLine[]
  inventoryPeriods RoomInventoryPeriod[]
  holds            Hold[]
  pickupSnapshots  PickupSnapshot[]
  units            Unit[]
  photos           RoomTypePhoto[]
  ratePlanMappings ChannelRatePlanMapping[]

  @@index([propertyId])
}

// A photograph of a room type, shown on the hotel's own booking page.
//
// The IMAGE BYTES are not here — only the object keys. Photos live in object storage (see
// @revio/storage): a hundred properties at ~50 MB each would put 5 GB inside the row store, which
// bloats every backup, costs an order of magnitude more per GB, and routes every image request
// through the Next server instead of a CDN. The email logo IS in Postgres and that is correct; it
// is one 20 KB file per property. The difference is volume, not principle.
//
// Two keys per photo because the gallery and the card need very different sizes, and shipping a
// 1600px image into a 200px slot is most of what makes a booking page feel slow on a phone.
model RoomTypePhoto {
  id         String @id @default(cuid())
  tenantId   String
  propertyId String
  roomTypeId String

  // Object keys, not URLs — the public origin can change (bucket → CDN) with no data migration.
  fullKey  String
  thumbKey String

  width    Int
  height   Int
  // Bytes of the full variant, so a hotel's storage footprint is answerable without listing a bucket.
  byteSize Int

  // Guest-visible alt text. Empty is allowed and renders decorative rather than leaking a filename.
  alt String @default("")

  // Lowest sortOrder is the card image. Reordering is how a hotel picks its hero shot.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, sortOrder])
  @@index([propertyId])
}

model CancellationPolicy {
  id          String  @id @default(cuid())
  tenantId    String
  propertyId  String
  name        String
  code        String
  description String?

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlans RatePlan[]

  @@index([propertyId])
}

model MealPlan {
  id         String @id @default(cuid())
  tenantId   String
  propertyId String
  name       String
  code       String

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlans RatePlan[]

  @@index([propertyId])
}

model RatePlan {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String
  code       String
  // Arbitrary labels the hotel uses for orientation, e.g. ["breakfast","non-refundable","corporate"].
  tags       String[]
  priceLogic String   @default("manual") // manual | derived

  // Derived-rate config (when priceLogic = derived) — consumed by @revio/core deriveRate().
  parentRatePlanId    String?
  derivedType         String? // percent | fixed
  derivedDirection    String? // increase | decrease
  derivedValue        Int? // percent (0-100) or minor units
  derivedRounding     String? // none | nearest_minor_1 | nearest_minor_50 | end_99
  derivedFloorMinor   Int?
  derivedCeilingMinor Int?

  /// per_room | per_person | null = inherit the property default. Mirrors Channex `sell_mode`,
  /// which is per rate plan for exactly this reason.
  pricingModel         String?
  /// Which occupancy option is primary. Null inherits the room type's `defaultOccupancy`.
  /// Exactly one option per plan is primary, and restrictions ride on it — Channex has no
  /// occupancy dimension on restrictions (§6.7a).
  primaryOccupancy     Int?
  /// manual | derived | cascade | auto. **`cascade` is the one that matters**: a plan that is BOTH
  /// derived from a parent AND per-person derives each occupancy from the parent's MATCHING
  /// occupancy. The two derivation axes — plan-to-plan and occupancy-to-occupancy — are orthogonal,
  /// and tangling them is named in the spec as the main failure mode.
  rateMode             String?
  /// Children and infants are a SEPARATE axis from adult occupancy (§6.9) and must never be folded
  /// into it. Stored here so the model is ready; pricing activates later.
  childrenFeeMinor     Int     @default(0)
  infantFeeMinor       Int     @default(0)
  cancellationPolicyId String?
  mealPlanId           String?

  // Default restriction baseline (fallback when nothing more specific applies).
  defStopSell           Boolean @default(false)
  defMinLos             Int?
  defMaxLos             Int?
  defCta                Boolean @default(false)
  defCtd                Boolean @default(false)
  defAdvancePurchaseMin Int?
  defAdvancePurchaseMax Int?

  active               Boolean @default(true)
  sortOrder            Int     @default(0)
  // Booking-engine seam (docs/specs/BOOKING-ENGINE-ADDENDUM.md §6): may this plan be sold on the
  // hotel's own direct channel (public widget)? OTA-only / corporate-only rates switch this off.
  // Designed-in now; the widget build is deferred.
  directChannelEnabled Boolean @default(true)

  dailyCells         DailyCell[]
  property           Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  parent             RatePlan?                @relation("Derivation", fields: [parentRatePlanId], references: [id])
  children           RatePlan[]               @relation("Derivation")
  cancellationPolicy CancellationPolicy?      @relation(fields: [cancellationPolicyId], references: [id])
  mealPlan           MealPlan?                @relation(fields: [mealPlanId], references: [id])
  roomTypeLinks      RatePlanRoomType[]
  channelMappings    ChannelRatePlanMapping[]
  ratePrices         RatePrice[]
  resLines           ReservationLine[]
  occupancyOptions   RatePlanOccupancy[]

  @@index([propertyId])
}

// One occupancy row under a rate plan — the Channex `options[]` entry, and the OBP store.
//
// ## This model was renamed, and the rename is the point
//
// It was `OccupancyAdjustment`: a price DELTA relative to the plan's base price. That shape works
// for "two guests minus €10" and breaks on everything else the spec asks for — it cannot say which
// occupancy is primary, it cannot hold an explicit price for an occupancy, and it has no row at all
// for a per-room plan. It was also read by nothing: only the seed ever wrote one.
//
// The spec's shape is a first-class ROW per occupancy, which is also Channex's shape:
//
//   per_room   → exactly ONE row, at the room's max occupancy, primary.
//   per_person → one row per occupancy 1…max, contiguous, no gaps, exactly one primary.
//
// Per-room being the one-row special case is what makes switching models a row expand/collapse
// rather than a fork in every query — and it is why both models share one schema.
//
// The old delta fields survive as the DERIVATION rule (`options[].derived_option`), which is what
// they always were. `mode` says whether this row's price is stated or computed.
model RatePlanOccupancy {
  id         String  @id @default(cuid())
  tenantId   String
  ratePlanId String
  /// Number of ADULTS this row prices. Children and infants are a separate axis (§6.9).
  occupancy  Int
  /// Exactly one per plan. The rate shown by default, and the one restrictions ride on — Channex
  /// restrictions have no occupancy dimension, so they attach to the primary and only to it.
  isPrimary  Boolean @default(false)
  /// manual — `rateMinor` is the price. derived — compute it from the primary using the rule below.
  mode       String  @default("manual")
  /// The plan-level default price for this occupancy. Per-DATE prices live on RatePrice; this is
  /// what a date with no explicit price falls back to, and what seeds a new calendar range.
  rateMinor  Int?

  // --- the derivation rule (Channex `derived_option`) — the old adjustment fields, unchanged ---
  adjustmentType String? // percent | fixed
  direction      String? // increase | decrease
  value          Int? // percent (0-100) or minor units
  rounding       String  @default("none")

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@unique([ratePlanId, occupancy])
  @@index([ratePlanId])
}

// What a stay was QUOTED, per night — the parity-within-the-stay rule (PMS OBP §P4).
//
// ## Why a snapshot exists at all
//
// Rates move after a booking is made. If the folio re-resolved against the live rate table on every
// render, a guest CONFIRMED at €120 could be BILLED €132 because somebody edited the occupancy table
// in between — and the folio would disagree with the confirmation email and with the OTA's record of
// the same booking. That is not a rounding difference, it is a dispute at the desk.
//
// So: the CRS QUOTES (live resolution at shop time) and the PMS BILLS WHAT WAS QUOTED. The two roles
// are deliberately distinct, and this table is the boundary between them.
//
// ## Why per night rather than one figure
//
// A stay spans dates that can price differently, and an occupancy change mid-stay repriaces only
// from the change forward — already-posted nights are not retroactively moved. Storing one total
// would make both impossible to express.
//
// Re-resolved ONLY on a real change: occupancy changed, or a move to a different room type. Never
// because a rate table was edited.
model ReservationNightRate {
  id                String   @id @default(cuid())
  tenantId          String
  reservationLineId String
  /// The night this rate is for — the date the guest sleeps, not the date it was quoted.
  date              DateTime @db.Date
  /// The adult count this night was priced at. Kept per night because it can change mid-stay.
  occupancy         Int
  rateMinor         Int
  /// When this night was last resolved, and why — "booking", "occupancy_change", "room_move".
  /// A night that has never been re-resolved still says "booking", which is the useful default.
  source            String   @default("booking")
  updatedAt         DateTime @default(now()) @updatedAt

  line ReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)

  @@unique([reservationLineId, date])
  @@index([reservationLineId])
}

// Room Type x Rate Plan = a sellable Product.
model RatePlanRoomType {
  ratePlanId String
  roomTypeId String

  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@id([ratePlanId, roomTypeId])
  @@index([roomTypeId])
}

// --- Channels & mapping ----------------------------------------------------

model Channel {
  id                    String    @id @default(cuid())
  tenantId              String
  propertyId            String
  code                  String // booking | expedia | trip | agoda
  name                  String
  status                String    @default("connected") // connected|not_connected|pending|error|disabled
  // Which adapter this channel pushes through (@revio/connectivity). Demo channels stay on "mock"; a
  // channel set to channex_* talks to the real Channex API. externalPropertyId is the Channex Property UUID.
  connectivityMode      String    @default("mock") // mock | channex_sandbox | channex_prod
  externalPropertyId    String?
  /// The Channex CHANNEL uuid — distinct from externalPropertyId, which says which hotel. Set when a
  /// channel is created through the API; needed to activate, update or delete it afterwards.
  externalChannelId     String?
  currency              String    @default("EUR")
  commissionPct         Float     @default(15)
  conversionType        String    @default("none") // none|manual|auto|channel_override
  markupPct             Float     @default(0)
  rounding              String    @default("none")
  supportedRestrictions String[]
  /// Whether this channel can express PER-OCCUPANCY rates (OBP §6.7 / L6).
  ///
  /// Default false — the honest one. A channel we have not confirmed gets the primary occupancy's
  /// rate as a scalar and says so on the limitations line, rather than being sent an options array
  /// it silently drops. Detected at connection time from the Channex adapter, never assumed.
  supportsOccupancy     Boolean   @default(false)
  lastSyncAt            DateTime?
  errorCount            Int       @default(0)
  pendingCount          Int       @default(0)
  // CRS reporting category this channel's bookings fall under (see BookingSource).
  bookingSourceId       String?

  property         Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingSource    BookingSource?           @relation(fields: [bookingSourceId], references: [id])
  roomTypeMappings ChannelRoomTypeMapping[]
  ratePlanMappings ChannelRatePlanMapping[]
  reservations     Reservation[]
  syncEvents       SyncEvent[]
  errorItems       ErrorItem[]

  @@index([propertyId])
}

// Two-stream mapping (V2): a channel maps each Room Type and each Rate Plan to the channel's own id,
// independently — mirrors Channex (availability keyed on room type, rates/restrictions on rate plan).
// Replaced the earlier single-row-per-product mapping, which carried both external ids at once.
model ChannelRoomTypeMapping {
  id             String  @id @default(cuid())
  tenantId       String
  channelId      String
  roomTypeId     String
  externalRoomId String?
  status         String  @default("incomplete") // complete | incomplete

  channel  Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelId, roomTypeId])
  @@index([channelId])
}

/// One of our rate plans, as it exists on one channel — **per room type**.
///
/// Channex (and every OTA under it) ties a rate plan to exactly ONE room type. We model a rate plan
/// at property level: a hotel has one "Standard Rate" that applies to all six of its room types.
/// Those two models only line up if the mapping carries the room type as well.
///
/// Without `roomTypeId` a hotel with three room types and one Standard Rate mapped that plan to a
/// single Channex rate plan, and every push sent all three room types at it — last write wins, so
/// two of the three silently carried the wrong price and had no rate plan on the channel at all. The
/// certification property never showed it because its data was hand-shaped 2×4 to match Channex.
///
/// **Nullable on purpose.** Null means "this mapping applies to any room type", which is what the
/// mock channels have always meant and what every existing row is. The resolver prefers an exact
/// room-type match and falls back to the null row, so nothing that works today stops working.
model ChannelRatePlanMapping {
  id             String  @id @default(cuid())
  tenantId       String
  channelId      String
  ratePlanId     String
  /// Null = applies to every room type (legacy rows, mock channels).
  roomTypeId     String?
  externalRateId String?
  status         String  @default("incomplete") // complete | incomplete

  channel  Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  ratePlan RatePlan  @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([channelId, ratePlanId, roomTypeId])
  @@index([channelId])
}

// --- Calendar data ---------------------------------------------------------

// Daily price for a (room type, rate plan). Only stored for manual rates; derived computed on read.
model RatePrice {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomTypeId String
  ratePlanId String
  date       DateTime @db.Date
  /// The occupancy this price is for — the dimension OBP adds.
  ///
  /// A per-room plan stores ONE row per date at the room's max occupancy, which is the same shape a
  /// per-person plan uses for its top row. That is deliberate: every reader can ask for
  /// (room, plan, date, occupancy) without branching on the pricing model, and switching a plan
  /// between models expands or collapses rows instead of moving data between tables.
  ///
  /// Nullable ONLY so the migration can backfill existing rows; every write sets it.
  occupancy  Int?
  priceMinor Int
  // Two-tier precedence provenance (docs/specs/CRS-GUIDE-V1.md §1.4): calendar and bulk are
  // PEERS — last write wins by recency — so every date-scoped value records when it was last
  // written and by which surface, or the audit trail can't explain which edit won.
  updatedAt  DateTime @default(now()) @updatedAt
  source     String   @default("calendar") // calendar | bulk | seed | api

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  // Occupancy is part of the key now. Without it a per-person plan could store only one price per
  // date and the second occupancy would silently overwrite the first.
  @@unique([roomTypeId, ratePlanId, date, occupancy])
  @@index([propertyId, date])
}

// Per-(room type, date) inventory allotment + restriction flags shown in the Calendar grid.
model DailyCell {
  id                 String   @id @default(cuid())
  tenantId           String
  propertyId         String
  roomTypeId         String
  /// Which rate plan this cell speaks for. **NULL means every plan of the room**, which is what a
  /// calendar edit or an unnarrowed bulk edit writes, and what every row written before this column
  /// existed means. A plan-specific cell wins over the room-wide one for that plan; the room-wide
  /// one still covers the plans that have no cell of their own.
  ///
  /// Without this, "minimum stay 2 on the flexible rate but 10 on bed & breakfast, over overlapping
  /// dates" was unrepresentable — the second edit simply overwrote the first.
  ratePlanId         String?
  date               DateTime @db.Date
  // Date-level "rooms to sell" allotment. Null ⇒ default to the room type's totalRooms.
  // Bookable = inventory − rooms sold (sold is derived from confirmed reservations, never stored here).
  inventory          Int?
  minLos             Int?
  maxLos             Int?
  cta                Boolean  @default(false)
  ctd                Boolean  @default(false)
  stopSell           Boolean  @default(false)
  advancePurchaseMin Int?
  advancePurchaseMax Int?
  // Two-tier precedence provenance — see RatePrice for the rationale (spec §1.4).
  updatedAt          DateTime @default(now()) @updatedAt
  source             String   @default("calendar") // calendar | bulk | seed | api

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan? @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  // Postgres treats NULLs as distinct, so this alone would allow many room-wide cells for one date.
  // The migration adds a partial unique index over (roomTypeId, date) WHERE ratePlanId IS NULL to
  // close that, which Prisma cannot express.
  @@unique([roomTypeId, ratePlanId, date])
  @@index([propertyId, date])
  @@index([ratePlanId])
}

// Binary brand assets (today: the guest-email logo). Separate from Property so the row stays cheap
// to read — every screen loads the property, almost none of them need the image.
model BrandAsset {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  kind       String   @default("email_logo") // email_logo (more later: invoice logo, favicon)
  mimeType   String // image/png | image/jpeg | image/gif — never SVG (it can carry script)
  bytes      Bytes
  byteSize   Int
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind])
  @@index([propertyId])
}

// --- Restrictions ----------------------------------------------------------

model RestrictionRule {
  id               String   @id @default(cuid())
  tenantId         String
  propertyId       String
  name             String
  type             String // stop_sell|min_los|max_los|cta|ctd|advance_purchase_min|advance_purchase_max|channel_allocation
  roomTypeId       String?
  ratePlanId       String?
  channelCodes     String[]
  // CRS: scope by booking source category (docs/CRS-REFERENCE.md — e.g. closed to Travel Agent,
  // open to Direct). Empty = applies to every source. Categories match BookingSource.category.
  sourceCategories String[] @default([])
  dateFrom         DateTime @db.Date
  dateTo           DateTime @db.Date
  daysOfWeek       String   @default("all")
  valueInt         Int?
  valueBool        Boolean?
  priority         Int      @default(0)
  active           Boolean  @default(true)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// --- Reservations ----------------------------------------------------------

model Reservation {
  id                 String    @id @default(cuid())
  tenantId           String
  propertyId         String
  // Null for staff-entered bookings (Call Center / Direct / Corporate) — those never touch a CM.
  channelId          String?
  externalId         String?
  guestName          String
  // CM statuses: confirmed|modified|cancelled|failed_import|overbooked ("modified" = confirmed that
  // was modified — a flag-as-status, still counts as sold). CRS lifecycle adds:
  // draft|hold|expired|failed|no_show|archived (docs/CRS-REFERENCE.md "Reservation lifecycle").
  status             String    @default("confirmed")
  // ORIGINAL booking values (what the guest was actually charged), captured at booking time.
  totalMinor         Int
  currency           String    @default("EUR")
  // CRS-compatible currency snapshot: the same amount converted to the property's base currency, plus
  // the FX rate + timestamp used. Stored at booking time so historical revenue reports stay reproducible
  // when exchange rates move (see docs/CRS-REFERENCE.md "Currency handling"). Null on legacy rows.
  propertyCurrency   String?
  propertyTotalMinor Int?
  fxRate             Float?
  fxAt               DateTime?
  importedAt         DateTime  @default(now())
  syncStatus         String    @default("imported")
  // CRS fields (docs/CRS-REFERENCE.md). paymentGuarantee is a LABEL only — no card data in V1.
  guestId            String?
  bookingSourceId    String?
  paymentGuarantee   String? // card_on_file | company_account | prepaid_ota | none
  // A card guarantee taken by the booking engine. The TOKEN only — never a card number, which stays
  // with the gateway (PCI scope). brand/last4 exist so the front desk can recognise the card the
  // guest will present, and so a no-show charge can be raised against the right instrument.
  guaranteeRef       String?
  guaranteeBrand     String?
  guaranteeLast4     String?
  notes              String?
  cancelledAt        DateTime?
  // The stay ended. A PMS-owned OPERATIONAL fact, deliberately not a `status` value: `status` is the
  // CRS's commercial record, read by the availability waterfall, the CM's ARI pushes and every
  // revenue metric, and a departed guest's stay is still sold and still earns. Keeping departure in
  // its own column means the question "has this stay ended?" has one authoritative answer without
  // touching any of that. Set only by check-out; cleared only by a manager reopening the stay.
  departedAt         DateTime?
  createdById        String? // staff user who entered a manual booking

  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel       Channel?          @relation(fields: [channelId], references: [id], onDelete: Cascade)
  guest         Guest?            @relation(fields: [guestId], references: [id])
  bookingSource BookingSource?    @relation(fields: [bookingSourceId], references: [id])
  lines         ReservationLine[]
  stayGuests    StayGuest[]
  holds         Hold[]
  assignments   RoomAssignment[]
  folios        Folio[]
  stayExtras    StayExtra[]

  @@index([propertyId])
  @@index([channelId])
}

model ReservationLine {
  id            String   @id @default(cuid())
  reservationId String
  roomTypeId    String
  ratePlanId    String
  quantity      Int      @default(1)
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  // CRS: the line's accommodation price (whole stay, minor units) + guests staying. Null on legacy rows.
  priceMinor    Int?
  /// Adults on this line — the occupancy the stay is PRICED at (OBP §6.9: children and infants are a
  /// separate axis and must never be folded in here).
  guestsCount   Int?

  reservation Reservation            @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  nightRates  ReservationNightRate[]
  roomType    RoomType               @relation(fields: [roomTypeId], references: [id])
  ratePlan    RatePlan               @relation(fields: [ratePlanId], references: [id])
  assignments RoomAssignment[]

  @@index([reservationId])
}

// --- CRS: inventory periods, holds, guests, sources, taxes, snapshots ------
// (docs/CRS-REFERENCE.md — all tenant-owned, RLS tenant_isolation added in the migration.)

// Date-ranged unavailability for a room type: out-of-order (maintenance) or closure (seasonal).
// Waterfall level 1: available = physical − OOO − closed. Separate from the permanent total.
model RoomInventoryPeriod {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomTypeId String
  kind       String // out_of_order | closure
  dateFrom   DateTime @db.Date
  dateTo     DateTime @db.Date // inclusive
  rooms      Int      @default(1) // units affected (a closure usually = all units)
  note       String?
  // Set when this OOO period was created by a specific PMS Unit going out_of_order — the one
  // cross-product write (docs/PMS-REFERENCE.md): un-OOO deletes the period, restoring the waterfall.
  unitId     String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([roomTypeId, dateFrom])
  @@index([propertyId])
  @@index([unitId])
}

// Temporary inventory lock, placed the INSTANT a room is selected (before the form saves).
// Waterfall level 2: remaining = available − holds − confirmed. Expired holds are released by a job.
model Hold {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  roomTypeId    String
  reservationId String?
  quantity      Int      @default(1)
  checkIn       DateTime @db.Date
  checkOut      DateTime @db.Date
  status        String   @default("active") // active | converted | released | expired
  expiresAt     DateTime
  createdById   String?
  createdAt     DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType    RoomType     @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id])

  @@index([propertyId, status])
  @@index([roomTypeId, checkIn])
}

// Contact + booking history ONLY — hard scope line, not a CRM (no preferences/consent/loyalty).
model Guest {
  id                String    @id @default(cuid())
  tenantId          String
  propertyId        String
  firstName         String
  lastName          String
  email             String?
  /// True when `email` is an OTA forwarding address (abc@guest.booking.com) rather than the guest's
  /// own. It works while the booking is live and stops afterwards, so it is fine for messaging and is
  /// not identity — no screen may present it as the guest's address, and it must never reach a
  /// marketing list. Set when the address is first learned, not derived on read: the domain list
  /// changes, and a stored fact should not change with it.
  emailIsOtaAlias   Boolean   @default(false)
  phone             String?
  company           String?
  specialRequests   String? // free text
  createdAt         DateTime  @default(now())
  // Guest identity/merge (PMS-REFINEMENT-R1 §3.5, "foundational — build first"): when two records are the
  // same person (direct / OTA / walk-in duplicates), the loser is soft-merged INTO the winner. At merge the
  // app re-parents reservations + notes to the winner, then sets mergedIntoId on the loser so it drops out
  // of lists/metrics but its id stays resolvable (nothing is deleted). Stable identity underwrites every
  // guest metric across all products.
  mergedIntoId      String?
  // The guest asked not to be recognised across stays (K6). Set from the CRS guest profile when
  // someone exercises it. Suppresses every "welcome back" and every carried-over preference, while
  // leaving the booking history itself intact — a hotel still has to keep records it is legally
  // required to keep, and "don't greet me by name" is a different request from "erase me".
  recognitionOptOut Boolean   @default(false)
  /// When this guest exercised their right to erasure (GDPR Art. 17). The row SURVIVES with the
  /// person removed from it: reservations keep their link so occupancy and revenue history stay
  /// correct, and the tax invoice stays reconcilable to its stay. Set once and never cleared — it is
  /// what stops a second erasure and what tells a screen this is not merely an incomplete record.
  erasedAt          DateTime?

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  notes        GuestNote[]
  stayGuests   StayGuest[]
  mergedInto   Guest?        @relation("GuestMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Guest[]       @relation("GuestMerge")

  @@index([propertyId, lastName])
  @@index([mergedIntoId])
}

// Free-text staff notes on a guest (CRS-REFINEMENT-R2 §4). Multiple per guest, each stamped with
// author + time. Attached to the SHARED Guest record (not CRS-only): the note carries `tenantId`
// and hangs off the core Guest, so it is visible wherever that guest surfaces — CRS today, PMS when
// the property runs it. authorName is denormalized so the byline survives a user rename/removal.
model GuestNote {
  id         String   @id @default(cuid())
  tenantId   String
  guestId    String
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  guest Guest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([guestId, createdAt])
}

// Reporting category each channel/booking belongs to (Direct, OTA, GDS, Call Center, Corporate,
// Travel Agent). Channels map to a source; staff-entered bookings are tagged at creation.
model BookingSource {
  id         String  @id @default(cuid())
  tenantId   String
  propertyId String
  name       String
  category   String // direct | ota | gds | call_center | corporate | travel_agent
  active     Boolean @default(true)

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channels     Channel[]
  reservations Reservation[]

  @@unique([propertyId, name])
  @@index([propertyId])
}

// Percent taxes use pct; fixed use amountMinor (money = integer minor units, never floats).
// inclusion drives Room Revenue: "included" taxes are inside the displayed rate.
model TaxFee {
  id          String  @id @default(cuid())
  tenantId    String
  propertyId  String
  name        String
  type        String // percent | fixed
  pct         Float?
  amountMinor Int?
  basis       String // per_room | per_person | per_night | per_stay
  inclusion   String  @default("excluded") // included | excluded
  active      Boolean @default(true)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// Nightly record of rooms sold per future stay date. Pickup = sold NOW − sold at snapshot N days
// ago. Snapshots can never be backfilled — the job runs from Phase 1 day one.
model PickupSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  propertyId   String
  roomTypeId   String
  snapshotDate DateTime @db.Date // property-timezone date the snapshot was taken
  targetDate   DateTime @db.Date // the future stay date measured
  roomsSold    Int
  revenueMinor Int      @default(0)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([propertyId, roomTypeId, snapshotDate, targetDate])
  @@index([propertyId, targetDate])
}

// Property-level restriction fallback (priority level 4, below rate-plan defaults) + CRS settings.
model PropertyDefaults {
  id                       String  @id @default(cuid())
  tenantId                 String
  propertyId               String  @unique
  // --- Occupancy-based pricing (CRS §6.2). The property DEFAULT; a rate plan may override it,
  // because Channex sets sell_mode per rate plan and a hotel can legitimately run some plans
  // per-room and some per-person.
  /// per_room | per_person. Per-room is not a different model — it is the one-row special case at
  /// max occupancy, which is what lets switching be a row expand/collapse rather than a fork.
  pricingModel             String  @default("per_room")
  /// How rows are seeded when a plan first becomes per-person: copy | derive.
  /// `copy` puts the existing price on every occupancy; `derive` applies the seed offset downward
  /// from the primary. Neither loses the rate that was already there.
  occupancySeedMode        String  @default("copy")
  /// all | primary_expand. How per-occupancy prices render in the calendar and booking engine.
  /// A per-person plan on a 4-guest room is four rows per date; showing all of them by default
  /// makes a month unreadable, so the primary shows and the rest expand.
  occupancyDisplay         String  @default("primary_expand")
  /// Age bands, scaffolding the children/infant axis (§6.9) which is deliberately NOT adult
  /// occupancy. Shipped now so rate-plan child fees have something to reference later.
  ageInfantMax             Int     @default(2)
  ageChildMax              Int     @default(11)
  /// Whether the connected channel manager supports per-occupancy rates. READ-ONLY, detected from
  /// the CM — it gates whether OBP can be enabled at all or must degrade (§6.7).
  cmObpCapability          Boolean @default(false)
  defStopSell              Boolean @default(false)
  defMinLos                Int?
  defMaxLos                Int?
  defCta                   Boolean @default(false)
  defCtd                   Boolean @default(false)
  defAdvancePurchaseMin    Int?
  defAdvancePurchaseMax    Int?
  // Metric settings (docs/CRS-REFERENCE.md "Core metrics")
  countNoShowsAsSold       Boolean @default(true)
  revenueDisplay           String  @default("gross") // gross | net
  pickupOffsetDays         Int     @default(7)
  // City tax (spec §4.4): the CRS DEFINES the rule, the PMS applies it to the folio, the CM
  // discloses it to the OTA. The setting NEVER changes the rate exported to the channel manager.
  cityTaxMode              String  @default("payable_on_spot") // payable_on_spot | included
  /// How this property numbers its tax documents.
  ///
  /// `bg_10digit` — ЗДДС чл. 114, ал. 1, т. 2: a ten-digit number, Arabic numerals only, ascending,
  /// no duplication, no gaps, and never reset at year end. Default, because that is the market.
  /// `prefixed`   — the readable `INV-2026-0001` form, for a jurisdiction that permits it.
  ///
  /// A property setting rather than a constant: the numbering rule is the single most
  /// country-specific thing about an invoice, and hardcoding ours would quietly make every foreign
  /// hotel non-compliant instead of only the Bulgarian ones.
  invoiceNumberScheme      String  @default("bg_10digit")
  /// Where this property's own range begins. A hotel that already issues invoices by hand needs its
  /// software range clear of the numbers in its books — same problem, same answer, per property.
  invoiceNumberStart       BigInt  @default(1000000000)
  holdTtlMinutes           Int     @default(30)
  // Close Day escalation (round-2 §3.4). An unclosed day must never accumulate: miss seven and the
  // eighth needs closing seven times, which corrupts the daily record. Two stages, both per-property
  // because the business-day boundary already varies (some properties audit at 03:00, some at
  // midnight), so one rigid time would fit nobody.
  //   closeDeadlineMinutes — minutes past midnight of the FOLLOWING day at which a still-open day
  //     starts nudging the people who can act. Default 00:30.
  //   closeReminderWindowHours — how long that reminder can be dismissed before the system closes
  //     the day itself. Default 22h, so the hard stop lands ~22:30 the next day.
  closeDeadlineMinutes     Int     @default(30)
  closeReminderWindowHours Int     @default(22)
  // Switch the automatic close off for a property that would rather carry an open day than have one
  // closed without a human. Off by default is not an option: a day nobody closes is the failure.
  autoCloseEnabled         Boolean @default(true)
  // Action Center thresholds (docs/CRS-REFERENCE.md: every threshold a Setting, never hardcoded).
  lowAvailabilityThreshold Int     @default(2)
  // Invoicing config (spec §4.3/§4.6) — the "jurisdiction pack" as data, never hardcoded. VAT rates
  // per charge category (BG defaults: 20% standard, 9% reduced for accommodation) + issuer legal
  // identity for the tax document. Edited in Configuration (E7).
  /// Туристически данък (ЗМДТ чл. 61с ал. 1) — the municipal rate per нощувка, in minor units.
  ///
  /// Per property because the council sets it per settlement AND per category, so two hotels of one
  /// owner in two towns owe different amounts on the same night. Null until the hotel states theirs;
  /// a default would be a number somebody files.
  touristTaxRateMinor      Int?
  /// `Л` in the чл. 61с ал. 5 formula — the DECLARED bed base, which is a figure the hotel agreed
  /// with its municipality and not one we can derive. Seeded from room capacity as a suggestion.
  touristTaxBeds           Int?
  vatStandardPct           Int     @default(20)
  vatReducedPct            Int     @default(9)
  invoiceIssuerName        String?
  invoiceVatId             String?
  invoiceAddress           String?
  // Housekeeping inspection gate (spec §3.4). On ⇒ nothing is sellable until a supervisor inspects
  // ("clean" = cleaned-pending); off ⇒ cleaned counts as sellable. sellableStatuses() reads this.
  inspectionGate           Boolean @default(false)
  // Room auto-assignment (spec §4.1) — opt-in, OFF by default. "Suggest a room" works either way;
  // this only decides whether the evening-before pass auto-commits physical rooms.
  autoAssignEnabled        Boolean @default(false)
  // Compliance pack (spec §4.7) — the per-country selection that makes invoicing multimarket without
  // code. The fiscalization/e-invoicing boundary (F3) is gated by these flags.
  jurisdiction             String  @default("generic") // generic | bg | eu
  fiscalizationEnabled     Boolean @default(false)
  eInvoicingEnabled        Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// Gapless numbering (spec §4.3) — a per-property, per-doc-type counter incremented atomically so an
// invoice/proforma/credit-note series never skips a number. Separate series per docType.
/// The gapless counter behind a property's issued documents.
///
/// Under the Bulgarian scheme `docType` is **"tax"** for both invoices and credit notes: an известие
/// is a данъчен документ like a фактура, and "no duplication" applies across all of a taxable
/// person's documents, so one ascending range per property is the reading that cannot be wrong.
/// A proforma is NOT a tax document and keeps its own, separate, non-numeric run.
model InvoiceSeries {
  id         String @id @default(cuid())
  tenantId   String
  propertyId String
  docType    String // tax | proforma  (legacy rows: invoice | credit_note)
  prefix     String @default("")
  /// BigInt: a ten-digit number reaches 9999999999, past the 2147483647 ceiling of a 32-bit integer.
  nextNumber BigInt @default(1)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, docType])
}

// An issued tax document (spec §4.3) — "render this folio (or these lines) as a numbered tax
// document." Jurisdiction-agnostic: EN-16931-style fields (buyer VAT ID, taxable-supply date distinct
// from issue date, per-rate tax summary) so turning a market on is configuration, not a rebuild.
model TaxInvoice {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  folioId       String?
  docType       String   @default("invoice") // invoice | proforma | credit_note
  number        String // gapless, from the series (e.g. "INV-2026-0007")
  // Issuer legal identity (snapshot at issue).
  issuerName    String
  issuerVatId   String?
  issuerAddress String?
  // Buyer — for a company invoice the buyer tax/VAT ID is required.
  buyerName     String
  buyerVatId    String?
  buyerAddress  String?
  issueDate     DateTime @default(now())
  supplyDate    DateTime // date of taxable supply, distinct from issue date
  currency      String
  netMinor      Int
  taxMinor      Int
  grossMinor    Int
  taxSummary    Json // [{ category, ratePct, netMinor, taxMinor, grossMinor }]
  lineSnapshot  Json // the folio lines as they stood at issue
  fiscalRef     String? // filled by the fiscalization boundary (F3); null = not yet fiscalized
  status        String   @default("issued") // issued | void
  createdById   String?
  createdAt     DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, docType])
  @@index([reservationId])
}

// Roles = saved combinations of permission-group × access level (new roles are configuration,
// not code). Groups: reservations|rates|inventory|restrictions|users|reports|distribution|finance.
model PermissionRole {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  builtin  Boolean @default(false)

  access RoleAccess[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RoleAccess {
  id       String @id @default(cuid())
  tenantId String
  roleId   String
  group    String
  level    String @default("none") // none | view | edit

  role PermissionRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, group])
}

// --- PMS: physical units + housekeeping (docs/PMS-REFERENCE.md) ------------
// The PMS is the first product that cares WHICH physical room/bed (to clean/assign/bill it). A Unit is
// an addressable sellable unit under a RoomType; it does NOT change the availability math — RoomType
// counts stay the source of truth for what's sellable. Marking a Unit out_of_order writes a
// RoomInventoryPeriod so the shared waterfall takes it off sale (the ONE cross-product write).
// All tenant-owned → tenant_isolation RLS added in the migration.
model Unit {
  id                String   @id @default(cuid())
  tenantId          String
  propertyId        String
  roomTypeId        String
  label             String // room number / name (e.g. "101", "Sea View 2") or a bed label for hostels
  unitKind          String   @default("room") // room | bed (mirrors RoomType.unitKind; built rooms-first in V1)
  floor             String? // floor or zone — groups the housekeeping board
  // Current housekeeping status (single value; changes logged to AuditEntry). Occupancy status is
  // DERIVED from room assignments (Phase 2), never stored here.
  hkStatus          String   @default("clean") // clean | dirty | inspected | out_of_order
  // Assignment/housekeeping attributes (docs/specs/PMS-GUIDE-V1.md §3.5): connecting-room links are
  // REQUIRED data for the one-room-in-progress exception and family/group assignment; features feed
  // preference-aware assignment. Links are symmetric — the app maintains both sides (D6 UI).
  features          String[] @default([]) // quiet | accessible | view | smoking | …
  connectingUnitIds String[] @default([])
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  property         Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType         RoomType              @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  hkTasks          HousekeepingTask[]
  inventoryPeriods RoomInventoryPeriod[]
  assignments      RoomAssignment[]
  maintenanceTasks MaintenanceTask[]
  opsEvents        OpsEvent[]

  @@index([propertyId])
  @@index([roomTypeId, sortOrder])
}

// A housekeeping / turndown / inspection task, optionally against a specific Unit. Basic in V1.
model HousekeepingTask {
  id          String    @id @default(cuid())
  tenantId    String
  propertyId  String
  unitId      String?
  type        String    @default("clean") // clean | inspect | turndown
  status      String    @default("open") // open | in_progress | done
  assignee    String? // free-text staff name (or userId) — light in V1
  note        String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
}

// A physical Unit assigned to a reservation line for a date range (PMS front desk, Phase 2). Supports
// room moves (end one, open another). The operational check-in/out timestamps live HERE — the
// Reservation's sold/availability status is unchanged (a checked-in guest is still a confirmed, sold
// booking that the waterfall already counts). Stay state is derived: no checkedInAt = arriving;
// checkedInAt & no checkedOutAt = in-house; checkedOutAt set = departed.
model RoomAssignment {
  id                String    @id @default(cuid())
  tenantId          String
  propertyId        String
  reservationId     String
  reservationLineId String
  unitId            String
  checkIn           DateTime  @db.Date // stay window (copied from the line at assignment time)
  checkOut          DateTime  @db.Date
  status            String    @default("active") // active | moved | cancelled
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  // A HUMAN chose this room, so the optimiser never touches it again (§2.3).
  //
  // Auto-assignments stay fluid until arrival — the house keeps changing under them, and the
  // 0-12h pass re-places them on the best information anyone will ever have. A manual assignment
  // is frozen the moment it is made, permanently, including during that pass. Somebody decided
  // this guest goes in this room; being moved the night before because a score improved is worse
  // than any efficiency it could buy, and the calendar shows which is which so nobody is surprised.
  pinned            Boolean   @default(false)
  note              String?
  createdAt         DateTime  @default(now())

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  line        ReservationLine @relation(fields: [reservationLineId], references: [id], onDelete: Cascade)
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([unitId, status])
  @@index([reservationId])
}

// The in-house bill for a stay (PMS Phase 3). ONE folio per reservation. Accommodation lines come from
// the reservation rate (same source as CRS Room-Revenue, so the bill and the reports agree); extras/
// minibar/fees are new PMS lines. Payments are LABELS + amounts only — no card data (docs/PMS-REFERENCE.md).
model Folio {
  id            String    @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  // A stay can carry more than one folio (spec §3.6): the primary (guest) folio plus company /
  // split folios. Charge lines move between a reservation's folios to deliver every split.
  label         String    @default("Guest")
  isPrimary     Boolean   @default(true)
  status        String    @default("open") // open | closed
  // How a CLOSED folio ended, so "closed" is never ambiguous about money (null while open):
  //   settled         — balance reached zero the ordinary way.
  //   outstanding     — closed carrying a balance. A tracked receivable, NOT limbo: the debt is still
  //                     owed and still visible, and it is what the receivables view lists.
  //   paid_offsystem  — the money arrived another way (bank transfer, cash, external POS). Revenue
  //                     COLLECTED.
  //   written_off     — the balance was forgiven. Revenue LOST.
  // The last two both close the folio at zero and must never be reported as the same thing: an owner
  // reading "€513 written off" is reading a loss, not a payment.
  outcome       String?
  // Who resolved a closed-outstanding folio, and why — recorded with the outcome, never inferred.
  outcomeNote   String?
  outcomeAt     DateTime?
  outcomeById   String?
  currency      String
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  lines       FolioLine[]

  @@index([reservationId])
  @@index([propertyId, status])
}

// One posting on a folio. Charges are positive amounts; a `payment` line reduces the balance.
// Balance = Σ(non-voided charge amounts) − Σ(non-voided payment amounts). Voids are flagged, not deleted.
model FolioLine {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  folioId       String
  // accommodation | minibar | extra | fee | tax | payment | deposit_held | deposit_use | deposit_refund
  // A HELD deposit (spec §4.4) is a LIABILITY: deposit_held/deposit_refund sit outside charges AND
  // payments; only deposit_use (applying it) counts against the balance. An APPLIED deposit is
  // simply a `payment` at capture.
  kind          String
  depositTypeId String? // which deposit type a deposit entry belongs to (for per-type reporting)
  // Written ONLY by the charge-posting service (spec §1.7): every charge carries its outlet and tax
  // category so the invoice can break out Spa vs Accommodation and summarise tax per rate (§4.3).
  outlet        String? // room | minibar | extra | spa | bar | restaurant | other  (null for payments)
  taxCategory   String? // standard | reduced | city_tax | exempt                    (null for payments)
  description   String
  amountMinor   Int
  method        String? // for payments (label only): cash | card | company_account | bank_transfer | prepaid_ota
  ref           String?
  voided        Boolean  @default(false)
  postedById    String?
  postedAt      DateTime @default(now())

  folio    Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([folioId])
}

// Chargeable-item catalog for minibar / extras (PMS Phase 4). Tapping an item posts a FolioLine
// (kind = category) to a stay's folio — turning Phase-3 free-text charges into tap-to-add items.
// Stay extras (spec §3.6) — "add breakfast for the whole stay" is NOT a one-off POS charge: it's a
// per-night recurring extra that accrues automatically at each night audit as its own folio line.
// BOUNDARY: adding one operationally never changes the CRS rate plan the guest booked — the rate plan
// stays as sold; the folio reflects reality.
model StayExtra {
  id            String   @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  name          String // Breakfast | Parking | Half-board | …
  priceMinor    Int // per night, or once for the whole stay — see `basis`
  // How often this posts. `per_night` is the original behaviour and stays the default, so every
  // existing row keeps accruing exactly as before. `per_stay` posts ONCE (an airport transfer, a
  // late checkout) — the night audit's idempotency ref drops the date for those, which is the whole
  // implementation.
  basis         String   @default("per_night") // per_night | per_stay
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@index([propertyId])
}

// Deposit types (spec §4.4) — Consumption / Damage / property-defined. A deposit is NOT revenue when
// taken; it's money held that may be returned. Each type carries its own behaviour and VAT timing,
// edited by the property accountant in Configuration (E7) — never hardcoded.
model DepositType {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  name       String
  // held    = sits in its own folio section, outside the running balance (default; damage deposits).
  // applied = recorded as a payment at capture; the balance drops (consumption-prepayment model).
  behaviour  String   @default("held") // held | applied
  // When the VAT point triggers: a held deposit isn't a taxable supply until applied; an applied
  // prepayment for a known service can trigger VAT at capture in the EU.
  vatTiming  String   @default("use") // capture | use
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PosItem {
  id             String   @id @default(cuid())
  tenantId       String
  propertyId     String
  name           String
  // Which outlet sells it (spec §3.7) — minibar is one outlet among several. The posting service
  // tags the folio line with this outlet. `category` is the item-vs-extra split (kept).
  outlet         String   @default("minibar") // minibar | spa | bar | restaurant
  category       String   @default("minibar") // minibar (product/item) | extra (service)
  priceMinor     Int
  // Sold to a GUEST on the booking page, not just posted by staff at the desk. Off by default: a
  // hotel's internal catalogue contains things no guest should be able to add to their own booking,
  // so appearing publicly is an explicit decision per item rather than a side effect of existing.
  directSellable Boolean  @default(false)
  // Only meaningful when directSellable — how the guest is quoted, and how it later accrues.
  basis          String   @default("per_stay") // per_stay | per_night
  // One line under the name on the booking page. Nothing a guest reads should need a hover.
  description    String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, category])
}

// A maintenance/repair task (PMS Phase 5), optionally against a Unit. Flagging it out-of-order sets the
// Unit OOO → the shared availability waterfall takes the room off sale (same wiring as housekeeping OOO).
model MaintenanceTask {
  id          String    @id @default(cuid())
  tenantId    String
  propertyId  String
  unitId      String?
  title       String
  status      String    @default("open") // open | in_progress | done
  priority    String    @default("normal") // low | normal | high
  assignee    String?
  setsOoo     Boolean   @default(false)
  // A photo of the fault (spec §3.8) — for the technician, HK exception reports, and damage-deposit
  // evidence. Demo stores a downscaled data URL; productionization swaps in object storage.
  photoUrl    String?
  createdById String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
}

// --- PMS R1 foundations: workforce clock-in + the ops event stream --------

// A clock-in shift on the SHARED identity (PMS-REFINEMENT-R1 §6.7 / §10.2-10.3). "Active now" = a shift
// row with clockOutAt = null. Feeds the workforce dashboard, housekeeping/maintenance assignment
// feasibility, and the clock-in KPI. Delegated clock-in records who did it (clockedInById). This is a
// light availability + KPI signal — NOT payroll/attendance/HR (§6.9, §10.6).
model StaffShift {
  id            String    @id @default(cuid())
  tenantId      String
  propertyId    String
  userId        String // the shared-identity user who is on shift
  role          String // the PMS role they are working (housekeeper | maintenance | reception | …)
  clockInAt     DateTime  @default(now())
  clockOutAt    DateTime?
  clockedInById String? // set when a supervisor/FD clocked them in (delegated); null = self clock-in

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, clockOutAt]) // "active now" lookups
  @@index([userId, clockInAt])
}

// The operational event stream (PMS-REFINEMENT-R1 §6.8 / §7.4 / §8.7). Every housekeeping/maintenance
// status change + clock-in is appended here (who · unit · from→to · when) — one immutable log that powers
// the live boards, the self-populating per-room timeline (§7.4), and the manager-only performance
// analytics. Employee data: manager/owner-only, EU worker-monitoring/GDPR aware — never a live staff
// leaderboard.
model OpsEvent {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  domain     String // housekeeping | maintenance | workforce
  action     String // status_change | clock_in | clock_out | assigned | inspection_pass | inspection_fail | …
  unitId     String? // the room this event concerns (null for workforce events)
  userId     String? // the staff member the event is ABOUT (e.g. the cleaner)
  actorId    String? // who performed the action (may differ: supervisor approving, delegated clock-in)
  fromState  String?
  toState    String?
  refId      String? // the task/assignment id this event belongs to (HousekeepingTask, MaintenanceTask, StaffShift)
  meta       String? // small JSON blob for extra context (reason, duration, etc.)
  at         DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([propertyId, at])
  @@index([unitId, at])
  @@index([propertyId, domain, at])
}

// --- Monitoring: Sync / Error / Audit -------------------------------------

model SyncEvent {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  channelId  String?
  kind       String // push | pull
  status     String // pending | success | failed
  summary    String
  detail     String?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel  Channel? @relation(fields: [channelId], references: [id])

  @@index([propertyId, createdAt])
}

model ErrorItem {
  id                String    @id @default(cuid())
  tenantId          String
  propertyId        String
  channelId         String?
  severity          String // info | warning | critical
  code              String
  message           String
  productLabel      String?
  dateAffected      DateTime? @db.Date
  recommendedAction String?
  resolved          Boolean   @default(false)
  createdAt         DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel  Channel? @relation(fields: [channelId], references: [id])

  @@index([propertyId, resolved])
}

model AuditEntry {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String
  userId      String?
  entity      String
  field       String?
  oldValue    String?
  newValue    String?
  source      String // manual | api | bulk | rule
  channelCode String?
  syncResult  String?
  createdAt   DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

/// Failed sign-in attempts, per app and per email typed.
///
/// Deliberately NOT tenant-scoped and deliberately carries NO RLS policy: a login attempt happens
/// before any tenant context exists — there is no session, no `app.tenant_id`, and often no account.
/// Attempts are keyed on the email AS TYPED whether or not it matches a user, because locking only
/// real accounts would turn the lockout message into an account-existence oracle.
///
/// The decision logic lives in `@revio/core` (`auth/login-gate.ts`); this table is only its memory.
/// Who signed in, when, from where, and what happened to their account (N5).
///
/// `LoginAttempt` next to this is a rate-limiting COUNTER, not a record — `recordLoginSuccess`
/// deletes the row, so until now a successful sign-in left no trace anywhere. "Who logged into my
/// account at 3am" had no answer, which for software a hotel runs its business on is a gap the
/// audit log for room moves and folio charges only made more obvious.
///
/// Deliberately separate from `AuditEntry`: that records what somebody DID to hotel data, this
/// records what happened to an ACCOUNT. They have different retention, different readers, and a
/// failed sign-in belongs to no tenant at all.
model AuthEvent {
  id             String   @id @default(cuid())
  /// cm | crs | pms | operator — which front door.
  scope          String
  /// See AUTH_EVENT in packages/db/src/auth-events.ts.
  type           String
  /// Null when the attempt matched no account, which is exactly when it is most worth keeping.
  userId         String?
  operatorUserId String?
  /// Null for operator events and for failures against an unknown address. A hotel may read its own
  /// staff's events; nothing else is theirs to see.
  tenantId       String?
  /// The address as typed. Kept even when it matches nothing — a run of attempts against
  /// almost-right addresses is the signal.
  email          String?
  ip             String?
  userAgent      String?
  /// Short human-readable context: "recovery code", "2 codes left", a lockout reason.
  detail         String?
  createdAt      DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([operatorUserId, createdAt])
  @@index([scope, type, createdAt])
}

model LoginAttempt {
  id              String    @id @default(cuid())
  /// Which app the attempt was against: cm | crs | pms | operator.
  scope           String
  /// Lowercased email as typed. Not a foreign key — it may match no user at all.
  identifier      String
  failures        Int       @default(0)
  lockouts        Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([scope, identifier])
  @@index([updatedAt])
}

/// Single-use links: staff invitations and password resets (N2).
///
/// Like LoginAttempt, deliberately NOT tenant-scoped and carrying NO RLS policy — both flows run
/// before any session exists, and a reset is requested by someone who by definition cannot sign in.
///
/// `tokenHash` is a SHA-256 of the token that went out in the email; the token itself is never
/// stored. A dump of this table therefore yields no working links. `userId` and `operatorUserId` are
/// both nullable and exactly one is set: hotel staff and our own staff live in different tables but
/// need the identical flow.
model AuthToken {
  id             String    @id @default(cuid())
  /// invite | reset
  purpose        String
  /// SHA-256 hex of the emailed token. Unique so a collision is a database error, not a login.
  tokenHash      String    @unique
  userId         String?
  operatorUserId String?
  /// Kept alongside the id so an expired token can still be described without joining.
  email          String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

/// A mutual-exclusion lease for a background job (CX1).
///
/// Channex asked us directly: "why do you do multiple feed calls at the same time?" Their booking
/// timeline showed the same revision delivered TWICE within one second, from two different IP
/// addresses. Our scheduler runs in-process (`instrumentation.ts`), so every server instance — a
/// second Railway replica, a developer's machine pointed at the same sandbox, a certification script
/// running while the deployed app ticks — polled the same feed on its own timer.
///
/// The scheduler's comment argued this was safe because the jobs are idempotent. That reasoning was
/// about OUR data and it held; it simply answered the wrong question. Idempotent on our side does
/// nothing about a partner's rate limit, their logs, or their opinion of us during certification.
///
/// Deliberately NOT tenant-scoped and carrying NO RLS policy, for the same reason as `LoginAttempt`:
/// a lease is infrastructure, held by a process across every tenant, before any session exists.
model JobLease {
  /// The job's stable name, e.g. "channex-pull". One row per job, ever.
  name       String    @id
  /// Who holds it — instance id + pid. Only ever read by a human working out which box is looping.
  holder     String
  /// A lease is a promise to finish or die by this time; after it, anyone may take over. This is
  /// what makes a crashed instance recoverable without anybody clearing a flag by hand.
  expiresAt  DateTime
  acquiredAt DateTime  @default(now())
  /// Bumped on every successful run — the cheapest possible "is the poller alive" signal.
  lastRunAt  DateTime?

  @@index([expiresAt])
}

/// One accommodated person, one stay — the row that makes up регистърът на настанените туристи.
///
/// Content fixed by Заповед № Т-РД-14-10 / 11.06.2019 (чл. 116 ал. 1 ЗТ). Compulsory for every
/// accommodation provider since 1 October 2019; class A names вили explicitly, so a villa keeps this
/// register exactly as a hotel does. The field rules live in `@revio/core/registry/tourist-register`.
///
/// This is NOT fiscalization. A guest register records who slept where; it reports no sale to НАП
/// and does not make this software СУПТО.
model StayGuest {
  id            String  @id @default(cuid())
  tenantId      String
  propertyId    String
  reservationId String
  /// The guest PROFILE, when this person is one we already know. Optional on purpose: the register
  /// must hold the travelling companion who will never have a profile of their own.
  guestId       String?

  /// Пореден номер от регистъра — sequential within the property, claimed under an advisory lock so
  /// two simultaneous check-ins cannot take the same one. Never reused.
  registerNo   Int
  /// Дата на регистрация — when the person was registered, which is check-in.
  registeredAt DateTime

  /// Име / Бащино име / Фамилно име — three columns on the образец, not one name.
  /// Script matters: Cyrillic for Bulgarian citizens, Latin for foreigners, as the national document
  /// writes them. Nullable because an entry opens blank at check-in and is completed afterwards.
  firstName       String?
  /// Бащино име — a Bulgarian patronymic. Most foreigners have none, and blank is correct.
  middleName      String?
  lastName        String?
  /// Тип на документ за самоличност — id_card | passport | other.
  documentType    String?
  /// ЕГН / ЛЧН / персонален идентификационен номер. Required of a Bulgarian citizen; a foreign
  /// tourist may genuinely have none.
  personalId      String?
  dateOfBirth     DateTime?
  /// Пол — "m" | "f".
  sex             String?
  /// Гражданство, ISO 3166-1 alpha-2. Decides which half of the order applies (т. 1.1 vs т. 1.2).
  nationality     String?
  documentNumber  String?
  /// Серия на документа — asked for by т. 1.2 (non-EEA/CH citizens) only.
  documentSeries  String?
  /// Държава, издала националния документ, ISO 3166-1 alpha-2.
  documentCountry String?

  /// Етаж, стая/апартамент — SNAPSHOT, written at check-in. A room move next season must not
  /// silently rewrite where somebody slept two years ago; the register records what happened.
  unitLabel String?
  floor     String?

  /// Ползване на туристически пакет (да/не).
  touristPackage Boolean @default(false)

  /// Анулирана регистрация — a column on the образец, and the reason a registration made in error is
  /// cancelled in place rather than deleted. A register whose numbering has holes cannot be shown to
  /// have had none.
  cancelled     Boolean @default(false)
  cancelledNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property    Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guest       Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)

  @@unique([propertyId, registerNo])
  @@index([reservationId])
  @@index([propertyId, registeredAt])
  @@index([guestId])
}
