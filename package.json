{
  "name": "revio-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Revio \u2014 composable hotel software platform (Channel Manager, Reservation/CRS, PMS) on one shared inventory core.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @revio/channel-manager dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/lint.mjs",
    "test": "pnpm -r test",
    "copy:lint": "node scripts/copy-lint.mjs",
    "db:seed": "pnpm --filter @revio/channel-manager db:seed",
    "verify": "pnpm typecheck && pnpm lint && pnpm copy:lint && pnpm authz:lint && pnpm silent:lint && pnpm money:lint && pnpm health:lint && pnpm a11y:lint && pnpm scrolllock:lint && pnpm test",
    "authz:lint": "node scripts/authz-lint.mjs",
    "silent:lint": "node scripts/silent-lint.mjs",
    "money:lint": "node scripts/money-lint.mjs",
    "health:lint": "node scripts/health-lint.mjs",
    "a11y:lint": "node scripts/a11y-lint.mjs",
    "scrolllock:lint": "node scripts/scroll-lock-lint.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8"
  }
}
